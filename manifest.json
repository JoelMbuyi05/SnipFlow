{
  "manifest_version": 3,
  "name": "Snipflow",
  "version": "1.0.0",
  "description": "Save code snippets from any website",
  
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  
  "permissions": [
    "storage",
    "contextMenus",
    "tabs",
    "scripting"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "background": {
    "service_worker": "extension/background.js"
  },
  
  "action": {
    "default_popup": "extension/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_title": "Snipflow"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["extension/content.js"],
      "run_at": "document_start"
    }
  ],
  
  "web_accessible_resources": [
    {
      "resources": ["extension/app.html"],
      "matches": ["<all_urls>"]
    }
  ]
}